# ── Servidor ──────────────────────────────────────────────
PORT=3001
PATH_SUBDOMAIN=api
NODE_ENV=development
# APP_URL: base pública para endpoints que necesitan ser alcanzables desde afuera
# (webhook de WhatsApp, callback de OAuth de Google) — puede ser un túnel (ngrok) en dev.
# ASSETS_URL: base para imágenes/archivos que carga el navegador (<img src>). Si la
# dejás vacía, usa APP_URL — pero si APP_URL es un túnel gratuito de ngrok, las
# imágenes NO van a cargar (ngrok muestra una advertencia que <img> no puede pasar,
# el navegador la bloquea con ORB). En dev, dejala apuntando siempre a localhost.
# FRONTEND_URL: base del frontend, usada para armar el link de la tienda online
# (/tienda/:slug) que la herramienta abrir_tienda le manda al cliente.
APP_URL=http://localhost:3001
ASSETS_URL=http://localhost:3001
FRONTEND_URL=http://localhost:8083

# ── Base de datos PostgreSQL ───────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=crm_db
DB_SCHEMA=public
LOG_SQL=false

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=ide_ia_jwt_secret_change_in_production
JWT_EXPIRES_IN=8h

# ── Sesión ────────────────────────────────────────────────
SESSION_SECRET=ide_ia_session_secret_change_in_production

# ── Anthropic API ─────────────────────────────────────────
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5

# ── Google Calendar (OAuth2 — Client ID/Secret de tu propia app, ver
# console.cloud.google.com → APIs y servicios → Credenciales) ─────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
